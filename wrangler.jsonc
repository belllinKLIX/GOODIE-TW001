    {
      "binding": "DB",
      "database_name": "goodie-db",
      "database_id": "834c0e48-35ed-4564-bd47-f5cbfbcfdb4d"
    }
  ],

  // 2. 寫入發信金鑰 (RESEND_API_KEY)
  "vars": {
    "RESEND_API_KEY": "re_MLR8he7Q_NXA6voGRIeGFnGNEESM162yU"
  }
}
