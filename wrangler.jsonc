{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goodie-tw-website",
  // vinext's official source entry. The Vite build generates dist/server/index.js.
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goodie-db",
      "database_id": "67ec88f6-f947-4b63-a640-033e8cf718bb"
    }
  ],
  "vars": {
    "RESEND_FROM_EMAIL": "Goodie Website <website@goodie-tw.com>"
  },
  // The value stays encrypted in Cloudflare and must never be committed to GitHub.
  "secrets": {
    "required": ["RESEND_API_KEY"]
  },
  "observability": {
    "enabled": true
  }
}
